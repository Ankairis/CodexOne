# The public origin users open in their browser. The OpenAI-compatible Base URL
# is this value plus /v1.
PUBLIC_URL=https://xxx.xxx.com
LISTEN_ADDR=:8080
APP_TIMEZONE=Asia/Shanghai

# Optional: direct reverse-proxy IPs/CIDRs allowed to supply X-Forwarded-For.
# Keep empty unless login logs show every visitor as the proxy address.
# TRUSTED_PROXY_CIDRS=172.17.0.1/32

# Leave empty on first boot to generate a random password. It is printed once
# in the server/container logs. This setting is only used before initialization.
# ADMIN_PASSWORD=replace-with-at-least-12-characters

REQUEST_RETENTION_DAYS=30
MAX_REQUEST_MIB=32
SESSION_TTL_HOURS=24

# Client identity presented to the Codex backend. Downstream callers cannot
# override User-Agent, Originator, Version, Authorization, or account ID.
CODEX_CLIENT_VERSION=0.146.0
# CODEX_USER_AGENT=codex-tui/0.146.0 (Mac OS 26.5.0; arm64) iTerm.app/3.6.10 (codex-tui; 0.146.0)

# SQLite compose uses these defaults.
STORAGE_DRIVER=sqlite
SQLITE_PATH=/data/codexone.db
MASTER_KEY_FILE=/data/master.key
LOG_PATH=/data/codexone.log

# PostgreSQL + Redis compose additionally requires both values below.
# Generate MASTER_KEY with: openssl rand -base64 32
# MASTER_KEY=
# POSTGRES_PASSWORD=
